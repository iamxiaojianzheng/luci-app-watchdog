#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
config=watchdog
dir="/tmp/$config/"

detect_firewall_type() {
    if command -v nft >/dev/null && [ -x /sbin/fw4 ]; then
        echo "nft"
    elif command -v iptables >/dev/null; then
        echo "iptables"
    else
        echo "unknown"
    fi
}

clear_rule(){
    local fw_type=$(detect_firewall_type)

    if [ "$fw_type" = "nft" ]; then
        local drop_handles=$(nft -a list ruleset 2>/dev/null | grep -E "watchdog Drop rule" | awk '{print $NF}')
        for handle in $drop_handles; do
            nft delete rule inet fw4 input handle $handle 2>/dev/null
        done
        nft delete set inet fw4 watchdog_blacklist 2>/dev/null
        nft delete set inet fw4 watchdog_blacklistv6 2>/dev/null
    elif [ "$fw_type" = "iptables" ]; then
        iptables -D INPUT -m set --match-set watchdog_blacklist src -j DROP 2>/dev/null
        ip6tables -D INPUT -m set --match-set watchdog_blacklistv6 src -j DROP 2>/dev/null
        ipset destroy watchdog_blacklist 2>/dev/null
        ipset destroy watchdog_blacklistv6 2>/dev/null
    fi
}

start_service() {
    local enable_value
    enable_value=$(uci get $config.config.enable 2>/dev/null || echo "0")
    
    if [ "$enable_value" -eq "1" ]; then
        # 在拉起新实例前强制清场旧残留进程与锁文件，确保单例无缝拉起
        stop_service >/dev/null 2>&1 || true
        clear_rule
        procd_open_instance
        procd_set_param command /usr/share/$config/$config
        procd_set_param respawn
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
        echo "$config is starting now ..."
    fi
}

stop_service() {
    clear_rule
    command -v fuser >/dev/null 2>&1 && fuser -k -9 "${dir}watchdog.lock" 2>/dev/null || true

    if [ -f "${dir}watchdog.pid" ]; then
        local main_pid=$(cat "${dir}watchdog.pid")
        [ -n "$main_pid" ] && kill -9 "$main_pid" 2>/dev/null
    fi

    # 精确检索防护程序路径，切勿使用模糊 grep watchdog
    local pids=$(pgrep -f "/usr/share/$config/$config")
    [ -n "$pids" ] && echo "$pids" | xargs kill -9 2>/dev/null

    # 清理残留的 logread 及 fifo 消费孤儿进程
    local sub_pids=$(pgrep -f "logread.fifo")
    [ -n "$sub_pids" ] && echo "$sub_pids" | xargs kill -9 2>/dev/null

    rm -f "${dir}logread.fifo" "${dir}watchdog.pid" "${dir}watchdog.lock"
    echo "Terminated $config process safely."
}

reload_service() {
    stop_service
    start_service
}

service_triggers() {
    procd_add_reload_trigger $config
}
